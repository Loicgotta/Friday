# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Configuration
SESSION_SECRET=generate_a_random_secret_here_at_least_32_chars

# URLs (ajuster pour production sur Render)
BASE_URL=http://localhost:3000
CALLBACK_URL=http://localhost:3000/auth/google/callback

# En production sur Render, utilisez:
# BASE_URL=https://votre-app.onrender.com
# CALLBACK_URL=https://votre-app.onrender.com/auth/google/callback
